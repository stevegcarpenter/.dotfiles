" --------------------- functions ---------------------
" Visual search on highlighted strings
function! s:VSetSearch()
    let temp = @s
    norm! gv"sy
    let @/ = '\V' . substitute(escape(@s, '/\'), '\n', '\\n', 'g')
    let @s = temp
endfunction
" Visual pattern search
xnoremap * :<C-u>call <SID>VSetSearch()<CR>/<C-R>=@/<CR><CR>
xnoremap # :<C-u>call <SID>VSetSearch()<CR>?<C-R>=@/<CR><CR>

" Do a diff of the current buffer with the saved file
function! s:DiffWithSaved()
    let filetype=&ft
    diffthis
    vnew | r # | normal! 1Gdd
    diffthis
    exe "setlocal bt=nofile bh=wipe nobl noswf ro ft=" . filetype
endfunction
com! DiffSaved call s:DiffWithSaved()

" --------------------- augroups ---------------------
" Make directory when it doesn't already exist
augroup Mkdir
  autocmd!
  autocmd BufWritePre *
    \ if !isdirectory(expand("<afile>:p:h")) |
        \ call mkdir(expand("<afile>:p:h"), "p") |
    \ endif
augroup END

" --------------------- cheat sheets ---------------------
" :Cheatsheet [name] -- open ~/.dotfiles/docs/<name>-cheatsheet.md (default
" "vim") read-only in a vertical split; q closes it. Plain-vim counterpart of
" nvim's glow-based :Cheatsheet (lua/core/cheatsheet.lua).
let s:cheatsheet_dir = expand('~/.dotfiles/docs')

function! s:CheatsheetNames(arglead, cmdline, cursorpos)
    let names = map(glob(s:cheatsheet_dir . '/*-cheatsheet.md', 0, 1),
        \ {_, path -> substitute(fnamemodify(path, ':t:r'), '-cheatsheet$', '', '')})
    return filter(names, {_, name -> name =~ '^' . a:arglead})
endfunction

function! s:Cheatsheet(name)
    let name = empty(a:name) ? 'vim' : a:name
    let path = s:cheatsheet_dir . '/' . name . '-cheatsheet.md'
    if !filereadable(path)
        echohl ErrorMsg | echomsg 'no cheat sheet at ' . path | echohl None
        return
    endif
    execute 'botright vsplit' fnameescape(path)
    setlocal readonly nomodifiable nobuflisted bufhidden=wipe noswapfile
    nnoremap <buffer> <silent> q :close<CR>
endfunction

com! -nargs=? -complete=customlist,s:CheatsheetNames Cheatsheet call s:Cheatsheet(<q-args>)
